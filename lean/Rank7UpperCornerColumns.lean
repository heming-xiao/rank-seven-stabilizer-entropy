def Branch.l (r : Branch) : Int := if r.lambda then 150 else 0
def Branch.y (r : Branch) : Int := if r.mu then 175 else 0
def slopes (r : Branch) (f : Nat→Int) (n v x : Int) : Int :=
  let b := if r.halfTail then n else 2*v
  let m := if r.halfMiddle then v else 2*n
  let z := match r.floor.val with | 0 => 5*n | 1 => 4*v | _ => 4*n+2*v
  let extra := if r.charge then 4*n+2*v-3*m-2*x else 0
  let core := -2*(707-r.l)*f 34*n-2*(707-r.y)*f 45*v+(707-r.y)*f 46*b
  if r.single then core+707*f 48*m+707*f 49*z+707*f 50*extra+
    (1414*f 51-2*r.l*f 52-2*r.y*f 53)*x
  else core+(1414*f 43+4242*f 44+3535*f 41)*n+1414*f 47*v
def term (r : Branch) (m : Key) (w : Wedge7) : Int :=
  1414*feature 0 m w-2*r.l*(feature 1 m w+feature 2 m w)-2*r.y*feature 3 m w+
  400*fast 42 m*enter w+slopes r (fun i => fast i m) (shared w) (high w) (missing w)
theorem slopesLinear (r : Branch) (f : Nat→Int) (n v x : Int) : slopes r f n v x=
    slopes r f 1 0 0*n+slopes r f 0 1 0*v+slopes r f 0 0 1*x := by
  rcases r with ⟨si,la,mu,tail,middle,fl,ch⟩
  rcases fl with ⟨val,b⟩
  have vals : val=0∨val=1∨val=2 := by omega
  rcases vals with rfl|rfl|rfl <;> cases tail <;> cases middle <;> cases ch <;> cases si <;>
    dsimp only [slopes] <;> grind only
