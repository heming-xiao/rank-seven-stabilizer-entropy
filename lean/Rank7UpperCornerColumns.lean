def ground (w : Wedge7) := labels[slot w]?.getD ((0,0),0,0)
def high (w : Wedge7) : Int := if occupied w 0 && occupied w 1 then 1 else 0
def second (w : Wedge7) : Int := if occupied w 0 && occupied w 2 then 1 else 0
def shared (w : Wedge7) := high w+second w
def missing (w : Wedge7) : Int := if occupied w 0 && occupied w 1 && occupied w 2 then -1 else 0
def enter (w : Wedge7) : Int := if w=UpperFrameGain.entering then 1 else 0
def feature (j : Fin 4) (m : Key) (w : Wedge7) : Int :=
  let f := ground w
  match j.val with | 0 => fast f.1.1 m | 1 => high w*fast f.1.2 m | 2 => second w*fast f.2.1 m | _ => high w*fast f.2.2 m
